      <create_parent_folder>N</create_parent_folder>
      <parameters>
        <pass_all_parameters>Y</pass_all_parameters>
        <parameter>
          <name>PROJECT_DIR</name>
          <stream_name />
          <value>${PROJECT_DIR}</value>
        </parameter>
      </parameters>
    </entry>
