                "    Source = Odbc.Query(\"dsn=ProyectoKDD\", \"SELECT \"\"producto_key\"\", \"\"cod_producto\"\", \"\"categoria\"\", \"\"linea\"\", \"\"nombre_producto\"\", \"\"stock\"\", \"\"precio_ultimo_observado\"\" FROM dim_productos\"),",
                "    Typed = Table.TransformColumnTypes(Source, {{\"producto_key\",type text}, {\"cod_producto\",type text}, {\"categoria\",type text}, {\"linea\",type text}, {\"nombre_producto\",type text}, {\"stock\",type number}, {\"precio_ultimo_observado\",type number}})",
