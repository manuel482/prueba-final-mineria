{
  "name": "ProyectoKDD",
  "compatibilityLevel": 1600,
  "model": {
    "culture": "es-ES",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "tables": [
      {
        "name": "Retail",
        "columns": [
          {
            "name": "fecha",
            "dataType": "dateTime",
            "sourceColumn": "fecha",
            "summarizeBy": "none",
            "formatString": "yyyy-MM-dd"
          },
          {
            "name": "InvoiceNo",
            "dataType": "string",
            "sourceColumn": "InvoiceNo",
            "summarizeBy": "none"
          },
          {
            "name": "stock_key",
            "dataType": "string",
            "sourceColumn": "stock_key",
            "summarizeBy": "none"
          },
          {
            "name": "pais",
            "dataType": "string",
            "sourceColumn": "pais",
            "summarizeBy": "none"
          },
          {
            "name": "customer_key",
            "dataType": "string",
            "sourceColumn": "customer_key",
            "summarizeBy": "none"
          },
          {
            "name": "importe",
            "dataType": "double",
            "sourceColumn": "importe",
            "summarizeBy": "sum"
          },
          {
            "name": "venta_bruta",
            "dataType": "double",
            "sourceColumn": "venta_bruta",
            "summarizeBy": "sum"
          },
          {
            "name": "devolucion",
            "dataType": "double",
            "sourceColumn": "devolucion",
            "summarizeBy": "sum"
          },
          {
            "name": "Quantity",
            "dataType": "double",
            "sourceColumn": "Quantity",
            "summarizeBy": "sum"
          },
          {
            "name": "UnitPrice",
            "dataType": "double",
            "sourceColumn": "UnitPrice",
            "summarizeBy": "sum"
          },
          {
            "name": "is_return",
            "dataType": "int64",
            "sourceColumn": "is_return",
            "summarizeBy": "sum"
          },
          {
            "name": "tramo_cantidad",
            "dataType": "string",
            "sourceColumn": "tramo_cantidad",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Retail",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Odbc.Query(\"dsn=ProyectoKDD\", \"SELECT \"\"fecha\"\", \"\"InvoiceNo\"\", \"\"stock_key\"\", \"\"pais\"\", \"\"customer_key\"\", \"\"importe\"\", \"\"venta_bruta\"\", \"\"devolucion\"\", \"\"Quantity\"\", \"\"UnitPrice\"\", \"\"is_return\"\", \"\"tramo_cantidad\"\" FROM gold_retail\"),",
                "    Typed = Table.TransformColumnTypes(Source, {{\"fecha\",type date}, {\"InvoiceNo\",type text}, {\"stock_key\",type text}, {\"pais\",type text}, {\"customer_key\",type text}, {\"importe\",type number}, {\"venta_bruta\",type number}, {\"devolucion\",type number}, {\"Quantity\",type number}, {\"UnitPrice\",type number}, {\"is_return\",Int64.Type}, {\"tramo_cantidad\",type text}})",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Venta Neta GBP",
            "expression": "SUM(Retail[importe])",
            "formatString": "#,0.00"
          },
          {
            "name": "Venta Bruta GBP",
            "expression": "SUM(Retail[venta_bruta])",
            "formatString": "#,0.00"
          },
          {
            "name": "Devoluciones GBP",
            "expression": "SUM(Retail[devolucion])",
            "formatString": "#,0.00"
          },
          {
            "name": "Tasa Devoluciones",
            "expression": "DIVIDE([Devoluciones GBP], [Venta Bruta GBP])",
            "formatString": "0.0%"
          },
          {
            "name": "Facturas",
            "expression": "DISTINCTCOUNT(Retail[InvoiceNo])",
            "formatString": "#,0.00"
          },
          {
            "name": "Clientes Identificados",
            "expression": "CALCULATE(DISTINCTCOUNT(Retail[customer_key]), Retail[customer_key] <> \"DESCONOCIDO\")",
            "formatString": "#,0.00"
          },
          {
            "name": "Venta Mes Anterior GBP",
            "expression": "CALCULATE([Venta Neta GBP], DATEADD(Fecha[fecha], -1, MONTH))",
            "formatString": "#,0.00"
          },
          {
            "name": "Crecimiento Mensual GBP",
            "expression": "DIVIDE([Venta Neta GBP]-[Venta Mes Anterior GBP], [Venta Mes Anterior GBP])",
            "formatString": "0.0%"
          },
          {
            "name": "Acumulado GBP",
            "expression": "TOTALYTD([Venta Neta GBP], Fecha[fecha])",
            "formatString": "#,0.00"
          },
          {
            "name": "Lineas",
            "expression": "COUNTROWS(Retail)",
            "formatString": "#,0"
          }
        ]
      },
      {
        "name": "Ventas",
        "columns": [
          {
            "name": "fecha",
            "dataType": "dateTime",
            "sourceColumn": "fecha",
            "summarizeBy": "none",
            "formatString": "yyyy-MM-dd"
          },
          {
            "name": "producto_key",
            "dataType": "string",
            "sourceColumn": "producto_key",
            "summarizeBy": "none"
          },
          {
            "name": "sucursal",
            "dataType": "string",
            "sourceColumn": "sucursal",
            "summarizeBy": "none"
          },
          {
            "name": "tipo_cliente",
            "dataType": "string",
            "sourceColumn": "tipo_cliente",
            "summarizeBy": "none"
          },
          {
            "name": "cantidad",
            "dataType": "double",
            "sourceColumn": "cantidad",
            "summarizeBy": "sum"
          },
          {
            "name": "precio_unit",
            "dataType": "double",
            "sourceColumn": "precio_unit",
            "summarizeBy": "sum"
          },
          {
            "name": "venta",
            "dataType": "double",
            "sourceColumn": "venta",
            "summarizeBy": "sum"
          },
          {
            "name": "costos",
            "dataType": "double",
            "sourceColumn": "costos",
            "summarizeBy": "sum"
          },
          {
            "name": "utilidad",
            "dataType": "double",
            "sourceColumn": "utilidad",
            "summarizeBy": "sum"
          },
          {
            "name": "cod_depto",
            "dataType": "string",
            "sourceColumn": "cod_depto",
            "summarizeBy": "none"
          },
          {
            "name": "cod_municipio",
            "dataType": "string",
            "sourceColumn": "cod_municipio",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Ventas",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Odbc.Query(\"dsn=ProyectoKDD\", \"SELECT \"\"fecha\"\", \"\"producto_key\"\", \"\"sucursal\"\", \"\"tipo_cliente\"\", \"\"cantidad\"\", \"\"precio_unit\"\", \"\"venta\"\", \"\"costos\"\", \"\"utilidad\"\", \"\"cod_depto\"\", \"\"cod_municipio\"\" FROM gold_ventas_productos\"),",
                "    Typed = Table.TransformColumnTypes(Source, {{\"fecha\",type date}, {\"producto_key\",type text}, {\"sucursal\",type text}, {\"tipo_cliente\",type text}, {\"cantidad\",type number}, {\"precio_unit\",type number}, {\"venta\",type number}, {\"costos\",type number}, {\"utilidad\",type number}, {\"cod_depto\",type text}, {\"cod_municipio\",type text}})",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Ventas Productos",
            "expression": "SUM(Ventas[venta])",
            "formatString": "#,0.00"
          },
          {
            "name": "Costos Productos",
            "expression": "SUM(Ventas[costos])",
            "formatString": "#,0.00"
          },
          {
            "name": "Utilidad Productos",
            "expression": "[Ventas Productos]-[Costos Productos]",
            "formatString": "#,0.00"
          },
          {
            "name": "Margen Productos",
            "expression": "DIVIDE([Utilidad Productos], [Ventas Productos])",
            "formatString": "0.0%"
          },
          {
            "name": "Unidades Productos",
            "expression": "SUM(Ventas[cantidad])",
            "formatString": "#,0.00"
          },
          {
            "name": "Precio Medio Ponderado",
            "expression": "DIVIDE([Ventas Productos], [Unidades Productos])",
            "formatString": "#,0.00"
          },
          {
            "name": "Ventas Mes Anterior",
            "expression": "CALCULATE([Ventas Productos], DATEADD(Fecha[fecha], -1, MONTH))",
            "formatString": "#,0.00"
          },
          {
            "name": "Crecimiento Mensual Productos",
            "expression": "DIVIDE([Ventas Productos]-[Ventas Mes Anterior], [Ventas Mes Anterior])",
            "formatString": "0.0%"
          },
          {
            "name": "Acumulado Productos",
            "expression": "TOTALYTD([Ventas Productos], Fecha[fecha])",
            "formatString": "#,0.00"
          },
          {
            "name": "Ventas Lactea",
            "expression": "CALCULATE([Ventas Productos], KEEPFILTERS(Productos[categoria] = \"LACTEA\"))",
            "formatString": "#,0.00"
          },
          {
            "name": "Ventas Categorias Seleccionadas",
            "expression": "CALCULATE([Ventas Productos], KEEPFILTERS(Productos[categoria] IN {\"LACTEA\", \"CARNICA\"}))",
            "formatString": "#,0.00"
          }
        ]
      },
