                "    Typed = Table.TransformColumnTypes(Source, {{\"fecha\",type date}, {\"ano\",Int64.Type}, {\"trimestre\",Int64.Type}, {\"mes\",Int64.Type}, {\"dia\",Int64.Type}, {\"ano_mes\",type text}})",
